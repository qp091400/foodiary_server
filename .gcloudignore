# Upload only deployable source. Keep private-file exclusions after the allowlist.
*
!/.dockerignore
!/.gcloudignore
!/Dockerfile
!/requirements.txt
!/requirements-ocr.txt
!/constraints-production.txt
!/alembic.ini
!/README.md
!/compose.production.yml
!/app/
!/app/**
!/alembic/
!/alembic/**
!/scripts/
!/scripts/**
!/deploy/
!/deploy/**
# 레시피 DB(준비된 것만): Cloud Run 이미지에 들어간다. 다른 sqlite와 ZIP은 올리지 않는다.
!/recipe-package.json
!/recipe_data/
!/recipe_data/image-seed/
!/recipe_data/image-seed/recipes.sqlite3
!/recipe_data/image-seed/manifest.json

.git/
.venv/
venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.cloudrun/
**/.cloudrun/
.env
.env.*
**/.env
**/.env.*
*.secrets.json
**/*.secrets.json
*.key
*.pem
**/*.key
**/*.pem
artifacts/
backups/
uploads/
*.db
