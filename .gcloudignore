# Upload only deployable source. Keep private-file exclusions after the allowlist.
*
!/.dockerignore
!/.gcloudignore
!/Dockerfile
!/requirements.txt
!/requirements-ocr.txt
!/constraints-production.txt
!/alembic.ini
!/README.md
!/app/
!/app/**
!/alembic/
!/alembic/**
!/scripts/
!/scripts/**
!/deploy/
!/deploy/**
# 레시피 DB(recipe_data/)는 올리지 않는다. cloudrun.py build가 빌드 버킷에 버전별로 한 번만 올리고, Cloud Build가 거기서 받는다.
!/recipe-package.json

.git/
.venv/
venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.cloudrun/
**/.cloudrun/
.env
.env.*
**/.env
**/.env.*
*.secrets.json
**/*.secrets.json
*.key
*.pem
**/*.key
**/*.pem
artifacts/
backups/
uploads/
*.db
