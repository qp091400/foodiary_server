# Upload only deployable source. Keep private-file exclusions after the allowlist.
*
!/.dockerignore
!/.gcloudignore
!/Dockerfile
!/requirements.txt
!/requirements-ocr.txt
!/constraints-production.txt
!/alembic.ini
!/README.md
!/compose.production.yml
!/app/
!/app/**
!/alembic/
!/alembic/**
!/scripts/
!/scripts/**
!/deploy/
!/deploy/**

.git/
.venv/
venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.cloudrun/
**/.cloudrun/
.env
.env.*
**/.env
**/.env.*
*.secrets.json
**/*.secrets.json
*.key
*.pem
**/*.key
**/*.pem
artifacts/
backups/
uploads/
*.db
