{
    admin off
    auto_https off
}

:80 {
    request_body {
        max_size 11MB
    }
    @api path /api /api/*
    handle @api {
        # Keep /api; the API server handles this prefix and its security checks.
        reverse_proxy api:8000 {
            transport http {
                response_header_timeout 180s
            }
        }
    }
    handle {
        # Caddy also forwards WebSocket connections for Expo hot reload.
        reverse_proxy {$WEB_UPSTREAM:host.docker.internal:8081}
    }
}
