{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	request_body {
		max_size 11MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy api:8000 {
		transport http {
			response_header_timeout 120s
		}
	}
}
