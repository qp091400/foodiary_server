{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	request_body {
		max_size 11MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	@api path /api /api/*
	handle @api {
		# Preserve /api for the API server's prefix handling.
		reverse_proxy api:8000 {
			transport http {
				response_header_timeout 180s
			}
		}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM:https://foodiary-app-ef2b5.web.app} {
			header_up Host {upstream_hostport}
		}
	}
}
