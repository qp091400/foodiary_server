# Generate the real file with scripts/configure_production.py. Do not commit it.
API_DOMAIN=api.example.com
WEB_UPSTREAM=https://foodiary-app-ef2b5.web.app
ACME_EMAIL=
POSTGRES_PASSWORD=
JWT_SECRET=
APP_ENV=production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Set the actual frontend origin(s). Native mobile apps do not use browser CORS.
CORS_ORIGINS=https://api.example.com
TRUSTED_HOSTS=api.example.com,localhost,127.0.0.1
AUTO_CREATE_TABLES=false
DEV_TOOLS=false
TIMEZONE=Asia/Seoul
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

OCR_ENGINE=paddle
OCR_LANG=korean
OCR_VERSION=PP-OCRv5
OCR_DETECTION_MODEL=PP-OCRv5_server_det
OCR_RECOGNITION_MODEL=korean_PP-OCRv5_mobile_rec
OCR_TEXTLINE_MODEL=PP-LCNet_x1_0_textline_ori
OCR_ORIENTATION_MODEL=PP-LCNet_x1_0_doc_ori
OCR_CPU_THREADS=2
OCR_DET_MAX_SIDE=1280
OCR_WARMUP=true
OCR_FAIL_CLOSED=true
RATE_LIMIT_ENABLED=true
AUTH_REQUESTS_PER_MINUTE=30
OCR_REQUESTS_PER_MINUTE=10
FOODSAFETY_API_KEY=
