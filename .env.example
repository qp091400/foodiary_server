# 이 파일을 .env로 복사해서 쓴다.
# 값 뒤에 주석을 붙이지 않는다 (도구에 따라 주석이 값으로 읽힐 수 있다).

# docker compose에서는 이 값 대신 compose 파일의 db 주소가 쓰인다.
# 로컬(venv)에서 직접 띄울 때는 호스트를 localhost로 바꾼다.
DATABASE_URL=postgresql+psycopg://fridge:fridge@db:5432/fridge

# 운영에서는 반드시 길고 무작위인 값으로: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# console: 인증 메일을 로그에 출력 / smtp: 실제 발송
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail 앱 비밀번호 (16자리)
SMTP_PASSWORD=
MAIL_FROM=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# paddle | none
OCR_ENGINE=paddle
OCR_LANG=korean
# 글자 위치 검출 해상도(긴 변 px). 0이면 원본 해상도 그대로(가장 느림).
# 휴대폰 사진 한 장 기준 0: 17~24초, 1280: 7~11초, 960: 6~8초 (개발 PC Docker, CPU). 시험한 사진에서는 인식 결과가 같았다.
OCR_DET_MAX_SIDE=0

# 식품안전나라 OpenAPI 키. 비우면 바코드 조회 비활성 (카테고리 추정만)
FOODSAFETY_API_KEY=

# 쉼표로 구분. 예: https://app.example.com,http://localhost:3000
CORS_ORIGINS=*
# true면 시작할 때 create_all로 테이블을 만든다 (개발용). 운영에서는 false + alembic upgrade head
AUTO_CREATE_TABLES=true
TIMEZONE=Asia/Seoul

# true면 로그인 없이 영수증 인식만 시험하는 페이지(/dev/receipt-test)가 열린다. 운영에서는 반드시 false
DEV_TOOLS=false
